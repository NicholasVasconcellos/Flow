{
  "name": "flow",
  "version": "0.1.0",
  "description": "Local task-orchestration runtime driving Claude Code through a fixed lifecycle per task.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "flow": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec --import tsx 'test/**/*.test.ts'",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js",
    "dev:web": "npm run dev --prefix web",
    "build:web": "npm run build --prefix web",
    "test:web": "npm run test --prefix web"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "ora": "^8.1.0",
    "simple-git": "^3.27.0",
    "ulid": "^2.3.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
